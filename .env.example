# Copy this file to ".env" for LOCAL development only.
#
# IMPORTANT: On Vercel, .env files are NOT uploaded/used. You must set these same
# variables in your Vercel project dashboard instead:
#   Project → Settings → Environment Variables → add MONGO_URI, CLIENT_ORIGIN
# then redeploy. This is what was causing the "Serverless Function has crashed" error —
# MONGO_URI was missing in Vercel's environment, not in this local file.

# MongoDB connection string.
# Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/meatbyalvi_tracker
# Or MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/meatbyalvi_tracker

# Port the API server runs on
PORT=5050

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:5173
